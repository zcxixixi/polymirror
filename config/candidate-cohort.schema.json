{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymirror.local/schemas/candidate-cohort.schema.json",
  "title": "PolyMirror preview Candidate cohort",
  "type": "object",
  "additionalProperties": false,
  "x-candidateCohortRules": ["unique candidate IDs", "unique candidate addresses case-insensitively"],
  "required": ["cohortId", "candidates"],
  "properties": {
    "cohortId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 24
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "x-candidateFreshIntakeRules": [
          "passed requires evidence sha256",
          "watchlist-only candidates must not carry approval evidence"
        ],
        "required": ["id", "freshIntakePassed"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1,
            "maxLength": 20
          },
          "address": {
            "type": "string",
            "pattern": "^0x[A-Fa-f0-9]{40}$"
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "freshIntakePassed": {
            "type": "boolean"
          },
          "freshIntakeEvidenceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conservative": { "$ref": "#/$defs/arm" },
        "standard": { "$ref": "#/$defs/arm" },
        "aggressive": { "$ref": "#/$defs/arm" }
      }
    }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "x-candidateArmRules": [
        "minPrice < maxPrice",
        "minPrice and maxPrice must be supplied together",
        "fixedUsd <= maxPositionUsd",
        "fixedUsd <= maxDailyVolumeUsd"
      ],
      "dependentRequired": {
        "minPrice": ["maxPrice"],
        "maxPrice": ["minPrice"]
      },
      "properties": {
        "fixedUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "maxPositionUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "maxDailyVolumeUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "maxOpenMarkets": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dailyLossCapPct": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
        "slippageTolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
        "minPrice": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxPrice": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
